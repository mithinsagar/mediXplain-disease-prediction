# -----------------------------------------------------------------------------
# MediXplain environment configuration
# Author:  Mithin Sagar S
# GitHub:  https://github.com/mithinsagar
#
# Copy this file to `.env` and fill in your own credentials.
# Never commit the resulting `.env` file to source control.
# -----------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=change-me-in-production

# LLM provider: openrouter | gemini | none
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Google Gemini (https://ai.google.dev/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Retrieval backend: faiss | tfidf
RAG_BACKEND=faiss

# Sentence-transformer model used for FAISS embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
