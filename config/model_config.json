{
  "_metadata": {
    "author": "Mithin Sagar S",
    "github": "https://github.com/mithinsagar",
    "project": "MediXplain - Explainable Disease Prediction System",
    "description": "Hyperparameters for the classical scikit-learn model zoo."
  },
  "logistic_regression": {
    "max_iter": 2000,
    "solver": "lbfgs",
    "n_jobs": -1,
    "C": 1.0
  },
  "bernoulli_nb": {
    "alpha": 1.0
  },
  "linear_svm": {
    "max_iter": 5000,
    "random_state": 42,
    "C": 1.0
  },
  "decision_tree": {
    "max_depth": 20,
    "random_state": 42,
    "class_weight": "balanced"
  },
  "random_forest": {
    "n_estimators": 100,
    "max_depth": 20,
    "min_samples_split": 4,
    "min_samples_leaf": 2,
    "n_jobs": -1,
    "random_state": 42
  },
  "adaboost": {
    "n_estimators": 50,
    "algorithm": "SAMME",
    "random_state": 42
  },
  "mlp": {
    "hidden_layer_sizes": [128, 64],
    "max_iter": 300,
    "early_stopping": true,
    "random_state": 42
  }
}
