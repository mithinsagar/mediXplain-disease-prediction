# -----------------------------------------------------------------------------
# MediXplain .gitignore
# Author:  Mithin Sagar S
# GitHub:  https://github.com/mithinsagar
# -----------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment secrets
.env
.env.local

# Data (regenerated / downloaded)
data/raw/*
data/processed/*
data/interim/*
!data/.gitkeep
!data/**/.gitkeep

# Model artifacts (regenerated by ml/train_models.py and rag/build_faiss_index.py)
models/*.pkl
models/*.joblib
models/*.keras
models/*.h5
models/*.faiss
models/*.txt
models/*.csv
models/*.npy
!models/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Type-checking and linting
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Distribution / packaging
*.manifest
*.spec

# TensorFlow / PyTorch caches
.keras/
.torch/
.transformers_cache/
.cache/

# Streamlit
.streamlit/

# Kaggle credentials
kaggle.json
